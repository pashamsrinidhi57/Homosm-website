---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Cta from '../../components/Cta.astro';
import WorkCard from '../../components/WorkCard.astro';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const styles = [...new Set(all.flatMap((e) => e.data.styles).filter((s) => s !== 'Commercial'))].sort();
const done = all.filter((e) => e.data.status === 'completed').length;
---
<Base title="Work | Homasm Interiors, Hyderabad" description="Completed and ongoing interior projects by Homasm: villas, 2 to 5 BHK homes, studios and commercial spaces in Hyderabad.">
  <Header />
  <main class="work">
    <section class="intro">
      <p class="eyebrow" data-reveal>Selected work</p>
      <h1 data-reveal style="--d:80ms">Homes we have <em>built,</em><br />not just designed.</h1>
      <p class="lede" data-reveal style="--d:160ms">From compact studios to villas and showrooms. Every project is designed and executed by one accountable team, on schedule.</p>
      <dl class="stats" data-reveal style="--d:240ms">
        <div><dt>{all.length}</dt><dd>Case studies</dd></div>
        <div><dt>{done}</dt><dd>Completed</dd></div>
        <div><dt>1</dt><dd>Team, design to handover</dd></div>
      </dl>
    </section>

    <div class="filters" data-filters role="group" aria-label="Filter projects">
      <div class="chips" data-group="kind">
        <button class="chip is-on" data-v="all" aria-pressed="true">All</button>
        <button class="chip" data-v="residential" aria-pressed="false">Residential</button>
        <button class="chip" data-v="commercial" aria-pressed="false">Commercial</button>
      </div>
      <div class="chips chips--style" data-group="style" aria-label="Style">
        <button class="chip chip--sm is-on" data-v="all" aria-pressed="true">Any style</button>
        {styles.map((s) => <button class="chip chip--sm" data-v={s.toLowerCase()} aria-pressed="false">{s}</button>)}
      </div>
    </div>

    <section class="grid" data-grid aria-live="polite">
      {all.map((e, i) => <WorkCard entry={e} index={i} size={i % 3 === 0 ? 'l' : 'm'} sizes={i % 3 === 0 ? '(min-width: 900px) 62vw, 100vw' : '(min-width: 900px) 38vw, 100vw'} />)}
    </section>
    <p class="empty" data-empty hidden>No projects match those filters yet. <a href="/work">Clear filters</a></p>
  </main>
  <Cta />
  <Footer />
</Base>

<style>
  .work { padding: 8rem var(--gutter) var(--s-9); max-width: 1380px; margin: 0 auto; }
  .intro { display: grid; gap: var(--s-4); max-width: 60rem; padding-bottom: var(--s-7); }
  h1 { font-size: var(--fs-5); }
  .lede { font-size: var(--fs-2); color: var(--text-muted); max-width: 46ch; margin: 0; }
  .stats { display: flex; gap: var(--s-7); margin: var(--s-4) 0 0; flex-wrap: wrap; }
  .stats div { display: grid; } .stats dt { font-family: var(--font-display); font-size: var(--fs-4); line-height: 1; } .stats dd { margin: 0.3rem 0 0; color: var(--text-muted); font-size: var(--fs-0); }

  .filters { position: sticky; top: 4.4rem; z-index: 20; display: flex; gap: var(--s-4) var(--s-6); flex-wrap: wrap; align-items: center; justify-content: space-between; padding: var(--s-3) 0; margin-bottom: var(--s-6); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .chips { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .chip { font: 600 0.85rem/1 var(--font-body); padding: 0.65rem 1.1rem; border-radius: var(--radius-pill); border: 1px solid var(--line-strong); background: transparent; color: var(--text); cursor: pointer; transition: background var(--dur-1), color var(--dur-1), border-color var(--dur-1); }
  .chip:hover { border-color: var(--text); }
  .chip.is-on { background: var(--brand); border-color: var(--brand); color: var(--on-brand); }
  .chip--sm { font-weight: 500; padding: 0.5rem 0.85rem; font-size: 0.8rem; }

  .grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--s-8) var(--s-6); align-items: start; }
  .grid :global(.card--l) { grid-column: span 7; }
  .grid :global(.card--m) { grid-column: span 5; }
  .grid :global(.card--m:nth-child(3n+2)) { margin-top: var(--s-8); }
  .empty { padding: var(--s-8) 0; text-align: center; color: var(--text-muted); font-size: var(--fs-2); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; gap: var(--s-7); } .grid :global(.card--l), .grid :global(.card--m) { grid-column: auto; margin-top: 0 !important; } .filters { top: 3.9rem; } }
</style>

<script>
  const root = document.querySelector('[data-filters]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] .card')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const state = { kind: 'all', style: 'all' };
  const params = new URLSearchParams(location.search);
  const pre = params.get('style')?.toLowerCase().replace(/-/g, ' ');
  function apply() {
    let n = 0;
    cards.forEach((c) => {
      const okK = state.kind === 'all' || c.dataset.kind === state.kind;
      const okS = state.style === 'all' || (c.dataset.styles ?? '').split('|').includes(state.style);
      const show = okK && okS;
      c.hidden = !show; if (show) { n++; c.classList.add('in'); }
    });
    if (empty) empty.hidden = n > 0;
    root?.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) => {
      const g = (b.parentElement as HTMLElement).dataset.group as 'kind' | 'style';
      const on = state[g] === b.dataset.v; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on));
    });
  }
  root?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip'); if (!b) return;
    const g = (b.parentElement as HTMLElement).dataset.group as 'kind' | 'style';
    state[g] = b.dataset.v!;
    const doIt = () => apply();
    if ('startViewTransition' in document) (document as any).startViewTransition(doIt); else doIt();
  });
  if (pre) { const hit = root?.querySelector<HTMLElement>(`[data-group="style"] [data-v="${pre}"]`); if (hit) { state.style = pre; apply(); } }
</script>
