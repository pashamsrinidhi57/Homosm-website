---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
---
<Base
  title="Homasm Interiors | Interior Designers in Hyderabad"
  description="Premium interior design and execution in Hyderabad. Watch a home built from bare site to finished interior."
>
  <Header />
  <main>
    <Hero />
    <section class="next" id="work">
      <p class="eyebrow">Next</p>
      <h2>Selected work, services and process are coming next.</h2>
    </section>
  </main>
</Base>

<style>
  .next { min-height: 70vh; display: grid; align-content: center; padding: 6rem var(--gutter); background: var(--bg-sunken); }
  .next .eyebrow { font-size: 0.72rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--text-muted); margin: 0 0 1rem; }
  .next h2 { font-size: clamp(2.2rem, 4.6vw, 3.8rem); max-width: 32ch; }
</style>
