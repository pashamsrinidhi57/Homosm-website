---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'work'>; size?: 'l' | 'm'; index?: number; sizes?: string }
const { entry, size = 'm', index = 0, sizes = '(min-width: 900px) 50vw, 100vw' } = Astro.props;
const d = entry.data;
---
<a class={`card card--${size}`} href={`/work/${entry.id}`} data-reveal style={`--d:${(index % 2) * 90}ms`}
   data-kind={d.kind} data-styles={d.styles.map((s) => s.toLowerCase()).join('|')}>
  <div class="card__media">
    <Image src={d.cover} alt={d.coverAlt} widths={[480, 800, 1200]} sizes={sizes} loading={index < 2 ? 'eager' : 'lazy'} style={`view-transition-name: work-${entry.id}`} />
    {d.status === 'in-progress' && <span class="card__tag">In progress</span>}
  </div>
  <div class="card__body">
    <div>
      <p class="eyebrow">{d.typology} · {d.location}</p>
      <h3>{d.title}</h3>
      <p class="card__sum">{d.summary}</p>
    </div>
    <span class="card__go" aria-hidden="true">View case study <i>→</i></span>
  </div>
</a>
<style>
  .card { display: grid; gap: var(--s-4); text-decoration: none; color: var(--text); }
  .card[hidden] { display: none; }
  .card__media { position: relative; overflow: hidden; border-radius: var(--radius-m); background: var(--bg-sunken); aspect-ratio: 4 / 3; }
  .card--l .card__media { aspect-ratio: 16 / 11; }
  .card__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.4s var(--ease); }
  .card:hover .card__media :global(img) { transform: scale(1.05); }
  .card__tag { position: absolute; left: var(--s-3); top: var(--s-3); background: var(--brand); color: var(--on-brand); font-size: var(--fs-0); font-weight: 600; padding: 0.3rem 0.7rem; border-radius: var(--radius-pill); }
  .card__body { display: flex; justify-content: space-between; align-items: end; gap: var(--s-4); }
  .card h3 { font-size: var(--fs-3); margin: 0.25rem 0 0.4rem; }
  .card__sum { margin: 0; color: var(--text-muted); max-width: 46ch; font-size: var(--fs-0); }
  .card__go { white-space: nowrap; font-size: var(--fs-0); font-weight: 600; border-bottom: 2px solid var(--brand); padding-bottom: 2px; opacity: 0.0; transform: translateX(-6px); transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease); }
  .card__go i { font-style: normal; display: inline-block; transition: transform var(--dur-2) var(--ease); }
  .card:hover .card__go, .card:focus-visible .card__go { opacity: 1; transform: none; }
  .card:hover .card__go i { transform: translateX(4px); }
  @media (hover: none) { .card__go { opacity: 1; transform: none; } }
  @media (max-width: 640px) { .card__body { flex-direction: column; align-items: start; } }
</style>
